# Template only — do NOT put real secrets in this file or commit them to git.
#
# Real keys belong in a file named `.env` in the project root (same folder as
# `docker-compose.yml`), e.g.:
#   c:\Users\Ben\Desktop\SDE intern\.env
#
# Copy this file there, fill in values, save. Docker Compose loads that `.env`
# automatically and substitutes into docker-compose.yml for the backend.
#
# If you ever pasted keys in chat or committed them by mistake, rotate the
# access key in AWS IAM and create a new pair.

USE_S3=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Optional CloudFront or S3 website domain (no https://)
# AWS_S3_CUSTOM_DOMAIN=
# Presigned URL lifetime in seconds (default 3600)
# AWS_QUERYSTRING_EXPIRE=3600
